-->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Peak Point Medical – Patient Registration</title>
  <link href="style.css" rel="stylesheet">
</head>
<body>

<!-- ============================================================
     HEADER / BANNER
============================================================ -->
<div id="banner">
  <div id="logo">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60" width="50" height="50">
      <circle cx="30" cy="30" r="28" fill="#ffffff" stroke="#0e5a6e" stroke-width="2"/>
      <rect x="24" y="12" width="12" height="36" rx="3" fill="#e05c00"/>
      <rect x="12" y="24" width="36" height="12" rx="3" fill="#e05c00"/>
    </svg>
  </div>
  <div id="banner-title">Peak Point Medical</div>
  <div id="banner-date">
    Date:
    <script>
      (function(){
        var days   = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
        var months = ["January","February","March","April","May","June",
                      "July","August","September","October","November","December"];
        var d = new Date();
        var suffix = "th";
        if (d.getDate()===1||d.getDate()===21||d.getDate()===31) suffix="st";
        else if (d.getDate()===2||d.getDate()===22) suffix="nd";
        else if (d.getDate()===3||d.getDate()===23) suffix="rd";
        document.write(days[d.getDay()]+", "+months[d.getMonth()]+" "+d.getDate()+suffix+", "+d.getFullYear());
      })();
    </script>
  </div>
</div>

<!-- ============================================================
     MAIN CONTENT
============================================================ -->
<div id="main-content">

  <form id="registration-form" onsubmit="return false;">

    <!-- PERSONAL INFORMATION -->
    <div class="section-bar">Patient Registration Form</div>
    <div class="form-section">
      <table class="form-table">

        <tr>
          <td class="lbl">First Name: <span class="req">*</span></td>
          <td>
            <input type="text" id="fname" name="fname"
                   maxlength="30" size="14"
                   pattern="[A-Za-z'\-]{1,30}"
                   title="1-30 characters. Letters, apostrophes, and dashes only."
                   required>
            <span class="err" id="err-fname"></span>
          </td>
          <td class="lbl">M.I.:</td>
          <td>
            <input type="text" id="mi" name="mi"
                   maxlength="1" size="3"
                   pattern="[A-Za-z]"
                   title="Single letter only. No numbers or special characters.">
            <span class="err" id="err-mi"></span>
          </td>
          <td class="lbl">Last Name: <span class="req">*</span></td>
          <td>
            <input type="text" id="lname" name="lname"
                   maxlength="30" size="14"
                   pattern="[A-Za-z'\-0-9]{1,30}"
                   title="1-30 characters. Letters, apostrophes, dashes, and numbers allowed."
                   required>
            <span class="err" id="err-lname"></span>
          </td>
        </tr>

        <tr>
          <td class="lbl">Date of Birth: <span class="req">*</span></td>
          <td colspan="5">
            <input type="date" id="dob" name="dob"
                   title="Enter your date of birth. Cannot be in the future or more than 120 years ago."
                   required>
            <span class="err" id="err-dob"></span>
          </td>
        </tr>

        <tr>
          <td class="lbl">Social Security: <span class="req">*</span></td>
          <td colspan="5">
            <input type="password" id="ssn" name="ssn"
                   maxlength="11" size="14"
                   pattern="\d{3}-?\d{2}-?\d{4}"
                   placeholder="XXX-XX-XXXX"
                   title="Enter your 9-digit Social Security Number in format XXX-XX-XXXX."
                   required>
            <span class="err" id="err-ssn"></span>
          </td>
        </tr>

        <tr>
          <td class="lbl">Phone Number:</td>
          <td>
            <input type="tel" id="phone" name="phone"
                   maxlength="14" size="14"
                   pattern="\(?\d{3}\)?[-\s]?\d{3}[-\s]?\d{4}"
                   placeholder="000-000-0000"
                   title="Enter phone number in format 000-000-0000.">
            <span class="err" id="err-phone"></span>
          </td>
          <td class="lbl">Email Address: <span class="req">*</span></td>
          <td colspan="3">
            <input type="email" id="email" name="email"
                   size="22"
                   placeholder="name@domain.tld"
                   title="Enter a valid email address in format name@domain.tld."
                   required>
            <span class="err" id="err-email"></span>
          </td>
        </tr>

        <tr>
          <td class="lbl">Address Line 1: <span class="req">*</span></td>
          <td colspan="5">
            <input type="text" id="addr1" name="addr1"
                   maxlength="30" size="48"
                   pattern=".{2,30}"
                   title="Required. Enter 2 to 30 characters."
                   required>
            <span class="err" id="err-addr1"></span>
          </td>
        </tr>

        <tr>
          <td class="lbl">Address Line 2:</td>
          <td colspan="5">
            <input type="text" id="addr2" name="addr2"
                   maxlength="30" size="48"
                   pattern=".{2,30}"
                   title="Optional. If entered, must be 2 to 30 characters.">
            <span class="err" id="err-addr2"></span>
          </td>
        </tr>

        <tr>
          <td class="lbl">City: <span class="req">*</span></td>
          <td>
            <input type="text" id="city" name="city"
                   maxlength="30" size="14"
                   pattern=".{2,30}"
                   title="Required. Enter city name, 2 to 30 characters."
                   required>
            <span class="err" id="err-city"></span>
          </td>
          <td class="lbl">State: <span class="req">*</span></td>
          <td>
            <select id="state" name="state" required
                    title="Select your state or territory.">
              <option value="">--</option>
              <option>AL</option><option>AK</option><option>AZ</option><option>AR</option>
              <option>CA</option><option>CO</option><option>CT</option><option>DE</option>
              <option>DC</option><option>FL</option><option>GA</option><option>HI</option>
              <option>ID</option><option>IL</option><option>IN</option><option>IA</option>
              <option>KS</option><option>KY</option><option>LA</option><option>ME</option>
              <option>MD</option><option>MA</option><option>MI</option><option>MN</option>
              <option>MS</option><option>MO</option><option>MT</option><option>NE</option>
              <option>NV</option><option>NH</option><option>NJ</option><option>NM</option>
              <option>NY</option><option>NC</option><option>ND</option><option>OH</option>
              <option>OK</option><option>OR</option><option>PA</option><option>PR</option>
              <option>RI</option><option>SC</option><option>SD</option><option>TN</option>
              <option selected>TX</option><option>UT</option><option>VT</option>
              <option>VA</option><option>WA</option><option>WV</option><option>WI</option>
              <option>WY</option>
            </select>
            <span class="err" id="err-state"></span>
          </td>
          <td class="lbl">Zip Code: <span class="req">*</span></td>
          <td>
            <input type="text" id="zip" name="zip"
                   maxlength="10" size="10"
                   pattern="\d{5}(-\d{4})?"
                   title="Required. Enter 5-digit ZIP or ZIP+4 format (XXXXX-XXXX)."
                   required>
            <span class="err" id="err-zip"></span>
          </td>
        </tr>

        <tr>
          <td class="lbl">Gender: <span class="req">*</span></td>
          <td colspan="5">
            <label class="radio-lbl"><input type="radio" name="gender" value="Male" required title="Select your gender."> Male</label>
            <label class="radio-lbl"><input type="radio" name="gender" value="Female"> Female</label>
            <label class="radio-lbl"><input type="radio" name="gender" value="Other"> Other</label>
            <span class="err" id="err-gender"></span>
          </td>
        </tr>

      </table>
    </div>

    <!-- MEDICAL HISTORY -->
    <div class="section-bar">Medical History</div>
    <div class="form-section">
      <table class="form-table">

        <tr>
          <td class="lbl">Check all that apply:</td>
          <td colspan="5">
            <label class="chk-lbl"><input type="checkbox" name="illness" value="Chicken Pox" title="Check if you have had Chicken Pox."> Chicken Pox</label>
            <label class="chk-lbl"><input type="checkbox" name="illness" value="Small Pox" title="Check if you have had Small Pox."> Small Pox</label>
            <label class="chk-lbl"><input type="checkbox" name="illness" value="Covid-19" title="Check if you have had Covid-19."> Covid-19</label>
            <label class="chk-lbl"><input type="checkbox" name="illness" value="Tetanus" title="Check if you have had Tetanus."> Tetanus</label>
            <label class="chk-lbl"><input type="checkbox" name="illness" value="Mumps" title="Check if you have had Mumps."> Mumps</label>
            <label class="chk-lbl"><input type="checkbox" name="illness" value="Measles" title="Check if you have had Measles."> Measles</label>
          </td>
        </tr>

        <tr>
          <td class="lbl">Have you been vaccinated? <span class="req">*</span></td>
          <td colspan="5">
            <label class="radio-lbl"><input type="radio" name="vaccinated" value="Yes" required title="Select your vaccination status."> Yes</label>
            <label class="radio-lbl"><input type="radio" name="vaccinated" value="No"> No</label>
            <label class="radio-lbl"><input type="radio" name="vaccinated" value="Partially"> Partially</label>
            <span class="err" id="err-vaccinated"></span>
          </td>
        </tr>

        <tr>
          <td class="lbl">Do you have insurance? <span class="req">*</span></td>
          <td colspan="5">
            <label class="radio-lbl"><input type="radio" name="insurance" value="Yes" required title="Indicate whether you have health insurance."> Yes</label>
            <label class="radio-lbl"><input type="radio" name="insurance" value="No"> No</label>
            <span class="err" id="err-insurance"></span>
          </td>
        </tr>

        <tr>
          <td class="lbl">Rate your pain level: <span class="req">*</span></td>
          <td colspan="5">
            <span class="slider-lbl">None</span>
            <input type="range" id="pain_scale" name="pain_scale"
                   min="0" max="10" value="0" step="1"
                   title="Slide to indicate your current pain level from 0 (none) to 10 (severe)."
                   oninput="updateSlider()">
            <span class="slider-lbl">Severe</span>
            &nbsp;
            <span id="pain-display" class="slider-value">0 — None</span>
          </td>
        </tr>

        <tr>
          <td class="lbl" style="vertical-align:top; padding-top:6px;">Describe current symptoms:</td>
          <td colspan="5">
            <textarea id="symptoms" name="symptoms"
                      rows="4" cols="50"
                      title="Optional. Describe your symptoms. Do not use quotation marks."
                      placeholder="Describe your symptoms, onset, and severity..."></textarea>
            <span class="err" id="err-symptoms"></span>
          </td>
        </tr>

      </table>
    </div>

    <!-- CREATE ACCOUNT -->
    <div class="section-bar">Create Account</div>
    <div class="form-section">
      <table class="form-table">

        <tr>
          <td class="lbl">User ID: <span class="req">*</span></td>
          <td colspan="5">
            <input type="text" id="userid" name="userid"
                   maxlength="30" size="20"
                   pattern="[A-Za-z][A-Za-z0-9_\-]{4,29}"
                   title="5-30 characters. Must start with a letter. Letters, numbers, underscore, and dash only. No spaces."
                   oninput="lowercaseUserID()"
                   required>
            <span class="hint">First character must be a letter. No spaces.</span>
            <span class="err" id="err-userid"></span>
          </td>
        </tr>

        <tr>
          <td class="lbl">Password: <span class="req">*</span></td>
          <td colspan="5">
            <input type="password" id="password" name="password"
                   minlength="8" maxlength="30" size="20"
                   title="8-30 characters. Must contain at least 1 uppercase letter, 1 lowercase letter, 1 number, and 1 special character. No quotation marks."
                   oninput="checkPasswordStrength()"
                   required>
            <span id="pw-strength" class="hint"></span>
            <span class="err" id="err-password"></span>
          </td>
        </tr>

        <tr>
          <td class="lbl">Confirm Password: <span class="req">*</span></td>
          <td colspan="5">
            <input type="password" id="password2" name="password2"
                   minlength="8" maxlength="30" size="20"
                   title="Re-enter your password exactly as entered above."
                   oninput="checkPasswordMatch()"
                   required>
            <span class="err" id="err-password2"></span>
          </td>
        </tr>

      </table>
    </div>

    <!-- BUTTONS -->
    <div id="form-buttons">
      <input type="reset"  id="btn-clear"  value="Clear Form" onclick="clearReview();">
      <input type="button" id="btn-review" value="Review"     onclick="reviewForm();">
      <input type="button" id="btn-submit" value="Submit"     onclick="submitForm();">
    </div>

  </form>

  <!-- REVIEW PANEL -->
  <div id="review-panel" style="display:none;">
    <div class="section-bar">&#10003; Please Review Your Information</div>
    <div class="form-section">
      <table class="form-table" id="review-table"></table>
      <div id="review-status"></div>
    </div>
  </div>

</div>

<!-- FOOTER -->
<div id="footer">
  <div id="footer-brand">
    <strong>Peak Point Medical</strong><br>
    PO Box 19134 &nbsp;|&nbsp; Pearland, TX 77584
  </div>
  <div id="footer-center">
    <button type="button" id="btn-contact"
            onclick="window.location='mailto:info@peakpointmedical.example.com'">
      Contact Us
    </button>
  </div>
  <div id="footer-social">
    <a href="https://facebook.com" target="_blank" rel="noopener">Facebook</a> &nbsp;|&nbsp;
    <a href="https://twitter.com"  target="_blank" rel="noopener">Twitter/X</a> &nbsp;|&nbsp;
    <a href="https://linkedin.com" target="_blank" rel="noopener">LinkedIn</a>
  </div>
</div>

<script src="script.js"></script>

<!-- END OF FILE: patient-form.html -->
</body>
</html>
